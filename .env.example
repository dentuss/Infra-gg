# Supabase — Project Settings → API Keys
# The publishable key is safe to expose to the browser; Row Level Security
# protects the data. Never put the secret (service role) key in a
# NEXT_PUBLIC_ variable.
# The BARE project URL, no path: the client appends /auth/v1, /rest/v1 and
# /storage/v1 itself. Pasting the REST endpoint here breaks sign-in.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Which deployment this build is: production | preview | development.
# Anything other than "production" shows an amber badge in the sidebar so
# nobody mistakes staging for the live app. Leave it as development locally.
NEXT_PUBLIC_APP_ENV=development

# Where the shared read-only board assets live — blueprints, gadget icons and
# the replay decoder. Leave BOTH unset to read them from the project above,
# which is what production and a normal local setup want. Staging sets them to
# production's values so it does not need its own copy: the blueprints alone
# are ~755 MB and a free project only gets 1 GB.
#
# Read-only. Thumbnails, .pptx import media and avatars are written by the app
# and always stay in this environment's own project.
# NEXT_PUBLIC_ASSET_SUPABASE_URL=
# NEXT_PUBLIC_ASSET_SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Environment matrix — set these in Vercel, not here.
#
#   Vercel env   Git branch   NEXT_PUBLIC_APP_ENV   Supabase project
#   ----------   ----------   -------------------   ----------------
#   Production   master       production            infragg      (live)
#   Preview      dev + PRs    preview               infragg-dev
#   -            local        development           either, your choice
#
# Preview additionally sets the two ASSET variables to production's URL and
# publishable key, so staging shows the real blueprints.
#
# The two Supabase projects are deliberately separate: staging must never be
# able to write to real team data, and migrations are proven on infragg-dev
# before they reach production. See CONTRIBUTING.md.
# ---------------------------------------------------------------------------
